dependency "vpc" {
  config_path = "../infra/aws/vpc"

  mock_outputs = {
    vpc_id                        = "vpc-mock"
    vpc_cidr_block                = "10.0.0.0/16"
    public_subnet_id              = "subnet-mock-public"
    private_external_subnet_ids   = ["subnet-mock-ext-1", "subnet-mock-ext-2"]
    private_internal_subnet_ids   = ["subnet-mock-int-1", "subnet-mock-int-2"]
    availability_zones            = ["us-west-2a", "us-west-2b"]
