# =============================================================================
# ROOT TERRAGRUNT CONFIGURATION
# AWS Full Stack: VPC → EKS → BNK Gateway API
#
# Generated by BNK-Forge
# Project: {{PROJECT_NAME}}
# Environment: {{ENVIRONMENT}}
# Platform: AWS
# =============================================================================

# -----------------------------------------------------------------------------
# LOCALS - Common Configuration
# -----------------------------------------------------------------------------
locals {
  # Project metadata
  project_name = "{{PROJECT_NAME}}"
  environment  = "{{ENVIRONMENT}}"
  aws_region   = "{{AWS_REGION}}"
  aws_profile  = "{{AWS_PROFILE}}"

  # Common tags applied to all AWS resources
  common_tags = {
    Project     = local.project_name
    Environment = local.environment
    ManagedBy   = "bnk-forge"
    Terraform   = "true"
  }

  # Kubernetes cluster name (used across all K8s modules)
  cluster_name = "${local.project_name}-${local.environment}-eks"
}

# -----------------------------------------------------------------------------
# REMOTE STATE CONFIGURATION (S3 Backend)
# -----------------------------------------------------------------------------
remote_state {
  backend = "s3"

  config = {
    bucket         = "{{S3_BUCKET_NAME}}"  # e.g., "my-terraform-state"
    key            = "${path_relative_to_include()}/terraform.tfstate"
    region         = local.aws_region
    encrypt        = true
    dynamodb_table = "{{DYNAMODB_TABLE}}"  # e.g., "terraform-lock"
    profile        = local.aws_profile
  }

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }
}

# -----------------------------------------------------------------------------
# TERRAFORM CONFIGURATION
# -----------------------------------------------------------------------------
terraform {
  source = "${get_repo_root()}//{{MODULE_PATH}}"
}

# -----------------------------------------------------------------------------
# AWS PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
generate "provider_aws" {
  path      = "provider_aws.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<EOF
provider "aws" {
  region  = "${local.aws_region}"
  profile = "${local.aws_profile}"

  default_tags {
    tags = ${jsonencode(local.common_tags)}
  }
}
EOF
}

# -----------------------------------------------------------------------------
# KUBERNETES PROVIDER CONFIGURATION (for K8s and BNK modules)
# -----------------------------------------------------------------------------
generate "provider_kubernetes" {
  path      = "provider_kubernetes.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<EOF
data "aws_eks_cluster" "cluster" {
  name = dependency.eks.outputs.cluster_name
}

data "aws_eks_cluster_auth" "cluster" {
  name = dependency.eks.outputs.cluster_name
}

provider "kubernetes" {
  host                   = data.aws_eks_cluster.cluster.endpoint
  cluster_ca_certificate = base64decode(data.aws_eks_cluster.cluster.certificate_authority[0].data)
  token                  = data.aws_eks_cluster_auth.cluster.token
}
EOF
}

# -----------------------------------------------------------------------------
# HELM PROVIDER CONFIGURATION (for BNK Helm charts)
# -----------------------------------------------------------------------------
generate "provider_helm" {
  path      = "provider_helm.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<EOF
provider "helm" {
  kubernetes {
    host                   = data.aws_eks_cluster.cluster.endpoint
    cluster_ca_certificate = base64decode(data.aws_eks_cluster.cluster.certificate_authority[0].data)
    token                  = data.aws_eks_cluster_auth.cluster.token
  }

  # For F5 OCI registry authentication
  registry_config_path = pathexpand("~/.config/helm/registry/config.json")
}
EOF
}

# =============================================================================
# MODULE DEPENDENCIES
# =============================================================================

# -----------------------------------------------------------------------------
# INFRASTRUCTURE LAYER
# -----------------------------------------------------------------------------

