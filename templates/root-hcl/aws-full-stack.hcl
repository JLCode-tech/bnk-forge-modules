    component_versions    = {}
  }

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# -----------------------------------------------------------------------------
# KUBERNETES LAYER
# -----------------------------------------------------------------------------

# Cert-Manager Module
dependency "cert_manager" {
  config_path = "../k8s/cert-manager"

  mock_outputs = {
    cert_manager_ready = true
    release_status     = "deployed"
  }

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# Network Setup Module (Optional - only if using network attachments)
dependency "network_setup" {
  config_path = "../k8s/network-setup"

  skip = {{SKIP_NETWORK_SETUP}}  # Set to true if not using F5 network attachments

  mock_outputs = {
    external_nad_name = "external-nad"
    internal_nad_name = "internal-nad"
  }

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# -----------------------------------------------------------------------------
# BNK PLATFORM LAYER
# -----------------------------------------------------------------------------

# FLO (F5 Lifecycle Operator) Module
dependency "flo" {
  config_path = "../bnk/flo"

  mock_outputs = {
    flo_ready        = true
    flo_namespace    = "f5-spk"
    crds_installed   = true
  }

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# -----------------------------------------------------------------------------
# BNK GATEWAY API LAYER
# -----------------------------------------------------------------------------

# BNK GatewayClass Module
dependency "bnk_gatewayclass" {
  config_path = "../bnk/bnk-gatewayclass"

  mock_outputs = {
    gatewayclass_name  = "f5-gateway-class"
    gatewayclass_ready = true
  }

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# Gateway Module
dependency "gateway" {
  config_path = "../bnk/gateway"

  mock_outputs = {
    gateway_name      = "f5-gateway"
    gateway_ready     = true
    gateway_addresses = ["10.0.10.100"]
  }

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# =============================================================================
# MODULE INPUTS
# These inputs are automatically populated from dependencies and variables
# =============================================================================

inputs = {
  # Common inputs
  project_name = local.project_name
  environment  = local.environment
  aws_region   = local.aws_region
  aws_profile  = local.aws_profile
  common_tags  = local.common_tags
  cluster_name = local.cluster_name

  # Module-specific inputs will be added here based on selected module
  # Examples:
  # vpc_id = dependency.vpc.outputs.vpc_id
  # cluster_endpoint = dependency.eks.outputs.cluster_endpoint
  # flo_ready = dependency.flo.outputs.flo_ready
}

# =============================================================================
# NOTES FOR DEPLOYMENT
# =============================================================================
#
# 1. Initialize modules in order:
#    terragrunt run-all init --terragrunt-working-dir infra/aws
#    terragrunt run-all init --terragrunt-working-dir k8s
#    terragrunt run-all init --terragrunt-working-dir bnk
#
# 2. Plan deployment:
#    terragrunt run-all plan --terragrunt-working-dir .
#
# 3. Apply in layers:
#    terragrunt run-all apply --terragrunt-working-dir infra/aws
#    terragrunt run-all apply --terragrunt-working-dir k8s
#    terragrunt run-all apply --terragrunt-working-dir bnk
#
# 4. Destroy (reverse order):
#    terragrunt run-all destroy --terragrunt-working-dir bnk
#    terragrunt run-all destroy --terragrunt-working-dir k8s
#    terragrunt run-all destroy --terragrunt-working-dir infra/aws
#
# =============================================================================
