# -----------------------------------------------------------------------------
# BNK FOUNDATION LAYER
# -----------------------------------------------------------------------------

# FAR Setup Module
dependency "far_setup" {
  config_path = "../bnk/far-setup"

  mock_outputs = {
    spk_namespace         = "f5-spk"
    utils_namespace       = "f5-utils"
    far_secret_name       = "far-secret"
