{
  "module": {
    "name": "BNK GatewayClass",
    "path": "bnk/bnk-gatewayclass",
    "version": "2.1.0",
    "layer": "bnk-gateway",
    "category": "gateway",
    "description": "Creates standard Kubernetes GatewayClass (gateway.networking.k8s.io/v1) for BNK 2.2 with auto-constructed controllerName. Waits for CNEInstance to be ready before creating GatewayClass.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["terraform", "kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/cneinstance",
        "reason": "CNEInstance must be Available before GatewayClass can be accepted"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "flo_namespace",
        "type": "string",
        "description": "Namespace where FLO is deployed (used for controllerName)",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_namespace",
        "default": "f5-cne-core"
      },
      {
        "name": "instance_ready",
        "type": "boolean",
        "description": "Gate from CNEInstance module",
        "source": "module",
        "from_module": "bnk/cneinstance",
        "from_output": "instance_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "auto"
      },
      {
        "name": "gatewayclass_name",
        "type": "string",
        "description": "Name for the GatewayClass resource",
        "default": "bnk-gatewayclass",
        "source": "user"
      },
      {
        "name": "controller_name",
        "type": "string",
        "description": "Controller name override (auto-constructed if empty)",
        "default": "",
        "source": "user"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Gate from FLO module",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready",
        "default": true
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "gatewayclass_name",
        "type": "string",
        "description": "Name of the created GatewayClass",
        "used_by": ["bnk/gateway"],
        "sensitive": false
      },
      {
        "name": "gatewayclass_ready",
        "type": "boolean",
        "description": "Flag indicating GatewayClass is accepted",
        "used_by": ["bnk/gateway"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes", "aws"],
    "optional": ["null", "time", "local"]
  },
  "deployment": {
    "order": 60,
    "estimated_time": "2 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
