{
  "module": {
    "name": "CNEInstance",
    "path": "bnk/cneinstance",
    "version": "2.0.0",
    "layer": "application",
    "category": "bnk",
    "description": "Creates CNEInstance custom resource which triggers FLO to deploy all BNK components (TMM, CWC, DSSM, Observer, OTEL, RabbitMQ, etc.). Waits for Available condition and verifies pods are running.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["terraform", "kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "bnk/flo",
        "reason": "FLO installs CRDs and manages CNEInstance lifecycle"
      },
      {
        "module": "k8s/network-setup",
        "reason": "NADs must exist before CNEInstance references them"
      },
      {
        "module": "k8s/bnk-cert-issuer",
        "reason": "ClusterIssuer must exist for certificate management"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "namespace",
        "type": "string",
        "description": "Namespace for CNEInstance and workloads",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "cne_instance_namespace",
        "default": "f5-bnk"
      },
      {
        "name": "manifest_version",
        "type": "string",
        "description": "BNK manifest version",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "manifest_version"
      },
      {
        "name": "far_secret_name",
        "type": "string",
        "description": "FAR image pull secret name",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "far_secret_name",
        "default": "far-secret"
      },
      {
        "name": "external_nad_name",
        "type": "string",
        "description": "External NAD name",
        "source": "module",
        "from_module": "k8s/network-setup",
        "from_output": "external_nad_name"
      },
      {
        "name": "internal_nad_name",
        "type": "string",
        "description": "Internal NAD name",
        "source": "module",
        "from_module": "k8s/network-setup",
        "from_output": "internal_nad_name"
      },
      {
        "name": "cluster_issuer_name",
        "type": "string",
        "description": "ClusterIssuer name",
        "source": "module",
        "from_module": "k8s/bnk-cert-issuer",
        "from_output": "cluster_issuer_name",
        "default": "bnk-ca-cluster-issuer"
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Gate from FLO module",
        "source": "module",
        "from_module": "bnk/flo",
        "from_output": "flo_ready"
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "auto"
      },
      {
        "name": "instance_name",
        "type": "string",
        "description": "Name of the CNEInstance resource",
        "default": "bnk-instance",
        "source": "user"
      },
      {
        "name": "deployment_size",
        "type": "string",
        "description": "Deployment size: Small, Medium, Large, Max",
        "default": "Small",
        "source": "user"
      },
      {
        "name": "cloud_provider",
        "type": "string",
        "description": "Cloud provider (aws, azure, or empty). Enables cloud-aware controller env vars.",
        "default": "",
        "source": "user"
      },
      {
        "name": "storage_class_name",
        "type": "string",
        "description": "StorageClass for DSSM PVCs (e.g. gp3 for AWS EBS CSI driver).",
        "default": "",
        "source": "user"
      },
      {
        "name": "cloud_az_subnet_mappings",
        "type": "list(object)",
        "description": "AZ-to-subnet mappings for cloud-network-mapping ConfigMap.",
        "default": [],
        "source": "user"
      },
      {
        "name": "intelligent_lb_enabled",
        "type": "boolean",
        "description": "Enable AI Intelligent Load Balancing (deploys f5-analyzer pod for F5BigAnalyzer CRs)",
        "default": false,
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "instance_ready",
        "type": "boolean",
        "description": "Gate output indicating CNEInstance is deployed and verified",
        "used_by": ["bnk/bnk-gatewayclass"],
        "sensitive": false
      },
      {
        "name": "namespace",
        "type": "string",
        "description": "Namespace of the CNEInstance",
        "used_by": ["bnk/bnk-gatewayclass"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes", "aws"],
    "optional": ["local", "null", "time"]
  },
  "deployment": {
    "order": 55,
    "estimated_time": "8 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
