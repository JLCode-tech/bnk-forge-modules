{
  "module": {
    "name": "F5 Lifecycle Operator (FLO)",
    "path": "bnk/flo",
    "version": "2.0.0",
    "layer": "application",
    "category": "bnk",
    "description": "Deploys F5 Lifecycle Operator via Helm. FLO manages the entire BNK control plane including CWC, DSSM, Observer, OTEL, RabbitMQ, and TMM (via CNEInstance). Includes CPCL key download and license activation.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["terraform", "helm", "kubernetes_manifest", "shell"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "k8s/bnk-prerequisites",
        "reason": "Needs namespaces, FAR secrets, and FLO version from manifest"
      },
      {
        "module": "k8s/bnk-cert-issuer",
        "reason": "FLO requires ClusterIssuer for certificate management"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "flo_namespace",
        "type": "string",
        "description": "Namespace for FLO deployment",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "cne_core_namespace",
        "default": "f5-cne-core"
      },
      {
        "name": "flo_version",
        "type": "string",
        "description": "FLO Helm chart version",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "flo_version"
      },
      {
        "name": "far_secret_name",
        "type": "string",
        "description": "FAR image pull secret name",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "far_secret_name",
        "default": "far-secret"
      },
      {
        "name": "cluster_issuer_name",
        "type": "string",
        "description": "ClusterIssuer name for certificate management",
        "source": "module",
        "from_module": "k8s/bnk-cert-issuer",
        "from_output": "cluster_issuer_name",
        "default": "bnk-ca-cluster-issuer"
      },
      {
        "name": "jwt_token",
        "type": "string",
        "description": "JWT token for F5 licensing",
        "source": "project_secret",
        "sensitive": true
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "auto"
      },
      {
        "name": "license_mode",
        "type": "string",
        "description": "License mode: connected or f5licenseproxy",
        "default": "connected",
        "source": "user"
      },
      {
        "name": "cert_manager_ready",
        "type": "boolean",
        "description": "Dependency gate from cert-manager",
        "source": "module",
        "from_module": "k8s/cert-manager",
        "from_output": "cert_manager_ready",
        "default": true
      },
      {
        "name": "container_platform",
        "type": "string",
        "description": "Container platform type (Generic, AWS, Azure). AWS enables cloud-aware GRPC and networking.",
        "default": "Generic",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "flo_namespace",
        "type": "string",
        "description": "Namespace where FLO is deployed",
        "used_by": ["bnk/cneinstance", "bnk/bnk-gatewayclass"],
        "sensitive": false
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Gate output indicating FLO is ready",
        "used_by": ["bnk/cneinstance"],
        "sensitive": false
      },
      {
        "name": "crds_installed",
        "type": "boolean",
        "description": "Gate output indicating CRDs are installed",
        "used_by": ["bnk/cneinstance"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes", "helm", "aws"],
    "optional": ["null", "time", "local"]
  },
  "deployment": {
    "order": 50,
    "estimated_time": "5 minutes",
    "requires_user_input": false,
    "sensitive_inputs": ["jwt_token"]
  }
}
