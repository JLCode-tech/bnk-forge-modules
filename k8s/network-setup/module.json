{
  "module": {
    "name": "Network Attachment Definitions",
    "path": "k8s/network-setup",
    "version": "2.0.0",
    "layer": "kubernetes",
    "category": "networking",
    "description": "Creates Multus NetworkAttachmentDefinitions (NADs) for TMM external/internal networks. No hardcoded PCI bus IDs — uses configurable CNI type and SR-IOV resource names.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["terraform", "kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "k8s/bnk-prerequisites",
        "reason": "NADs deployed to instance namespace created by prerequisites"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "namespace",
        "type": "string",
        "description": "Namespace for NADs (must match CNEInstance namespace)",
        "source": "module",
        "from_module": "k8s/bnk-prerequisites",
        "from_output": "cne_instance_namespace",
        "default": "f5-bnk"
      },
      {
        "name": "external_subnet_cidrs",
        "type": "list(string)",
        "description": "External subnet CIDRs for IPAM ranges",
        "source": "module",
        "from_module": "infra/aws/vpc",
        "from_output": "private_external_subnet_cidrs",
        "default": ["10.0.10.0/24", "10.0.11.0/24"]
      },
      {
        "name": "internal_subnet_cidrs",
        "type": "list(string)",
        "description": "Internal subnet CIDRs for IPAM ranges",
        "source": "module",
        "from_module": "infra/aws/vpc",
        "from_output": "private_internal_subnet_cidrs",
        "default": ["10.0.20.0/24", "10.0.21.0/24"]
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "auto"
      },
      {
        "name": "cni_type",
        "type": "string",
        "description": "CNI plugin type (host-device, sriov, vfio)",
        "default": "host-device",
        "source": "user"
      },
      {
        "name": "external_resource_name",
        "type": "string",
        "description": "SR-IOV device plugin resource name for external network",
        "default": "intel.com/external_netdevice",
        "source": "user"
      },
      {
        "name": "internal_resource_name",
        "type": "string",
        "description": "SR-IOV device plugin resource name for internal network",
        "default": "intel.com/internal_netdevice",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "external_nad_name",
        "type": "string",
        "description": "Name of external NAD",
        "used_by": ["bnk/cneinstance"],
        "sensitive": false
      },
      {
        "name": "internal_nad_name",
        "type": "string",
        "description": "Name of internal NAD",
        "used_by": ["bnk/cneinstance"],
        "sensitive": false
      },
      {
        "name": "nads_ready",
        "type": "boolean",
        "description": "Flag indicating NADs are ready",
        "used_by": ["bnk/cneinstance"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes"],
    "optional": []
  },
  "deployment": {
    "order": 31,
    "estimated_time": "30 seconds",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
