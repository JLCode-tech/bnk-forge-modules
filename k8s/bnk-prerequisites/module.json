{
  "module": {
    "name": "BNK Prerequisites",
    "path": "k8s/bnk-prerequisites",
    "version": "1.1.0",
    "layer": "kubernetes",
    "category": "setup",
    "description": "Creates BNK namespaces, FAR image pull secrets, and downloads the BNK manifest to parse component versions. This is the first module in the BNK stack — everything else depends on it.",
    "cloud_specific": false,
    "supported_platforms": ["any"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.4.1"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["terraform", "kubernetes_manifest", "shell"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "cne_pull_secret",
        "type": "string",
        "description": "Base64-encoded F5 FAR service account key JSON content",
        "source": "project_secret",
        "sensitive": true
      }
    ],
    "optional": [
      {
        "name": "operator_namespace",
        "type": "string",
        "description": "Namespace for FLO and all BNK components",
        "default": "f5-operator",
        "source": "user"
      },
      {
        "name": "utils_namespace",
        "type": "string",
        "description": "Namespace for utility components",
        "default": "f5-utils",
        "source": "user"
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Namespace for Gateway API resources",
        "default": "gateway-ns",
        "source": "user"
      },
      {
        "name": "bnk_manifest_version",
        "type": "string",
        "description": "BNK manifest version to download from FAR",
        "default": "2.4.1-3.2850.1-0.0.9",
        "source": "user"
      },
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "auto"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "operator_namespace",
        "type": "string",
        "description": "Operator namespace name (FLO + all BNK components)",
        "used_by": [
          "k8s/network-setup",
          "k8s/cert-manager",
          "bnk/flo",
          "bnk/cneinstance"
        ],
        "sensitive": false
      },
      {
        "name": "utils_namespace",
        "type": "string",
        "description": "Utilities namespace name",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "gateway_namespace",
        "type": "string",
        "description": "Gateway namespace name",
        "used_by": ["bnk/gateway", "bnk/routes"],
        "sensitive": false
      },
      {
        "name": "far_secret_name",
        "type": "string",
        "description": "Name of the FAR image pull secret (always 'far-secret')",
        "used_by": ["bnk/flo", "bnk/cneinstance"],
        "sensitive": false
      },
      {
        "name": "flo_version",
        "type": "string",
        "description": "FLO Helm chart version from manifest",
        "used_by": ["bnk/flo"],
        "sensitive": false
      },
      {
        "name": "manifest_version",
        "type": "string",
        "description": "BNK manifest version",
        "used_by": ["bnk/cneinstance"],
        "sensitive": false
      },
      {
        "name": "component_versions",
        "type": "map",
        "description": "All component versions from manifest",
        "used_by": [],
        "sensitive": false
      },
      {
        "name": "prerequisites_ready",
        "type": "boolean",
        "description": "Gate output — true when all prerequisites are ready",
        "used_by": ["k8s/network-setup", "k8s/cert-manager"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes", "aws"],
    "optional": ["local", "external", "null"]
  },
  "deployment": {
    "order": 30,
    "estimated_time": "60 seconds",
    "requires_user_input": false,
    "sensitive_inputs": ["cne_pull_secret"]
  }
}
